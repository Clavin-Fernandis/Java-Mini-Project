<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
version="3.1">

<servlet>
    <servlet-name>AddReservation</servlet-name>
    <servlet-class>
        com.hotel.servlet.AddReservationServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>AddReservation</servlet-name>
    <url-pattern>/add</url-pattern>
</servlet-mapping>

<servlet>
    <servlet-name>DisplayReservations</servlet-name>
    <servlet-class>
        com.hotel.servlet.DisplayReservationsServlet
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>DisplayReservations</servlet-name>
    <url-pattern>/display</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>UpdateReservation</servlet-name>
<servlet-class>com.hotel.servlet.UpdateReservationServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>UpdateReservation</servlet-name>
<url-pattern>/update</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>DeleteReservation</servlet-name>
<servlet-class>com.hotel.servlet.DeleteReservationServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>DeleteReservation</servlet-name>
<url-pattern>/delete</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>Report</servlet-name>
<servlet-class>com.hotel.servlet.ReportServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>Report</servlet-name>
<url-pattern>/report</url-pattern>
</servlet-mapping>

<servlet>
<servlet-name>ReportCriteria</servlet-name>
<servlet-class>com.hotel.servlet.ReportCriteriaServlet</servlet-class>
</servlet>

<servlet-mapping>
<servlet-name>ReportCriteria</servlet-name>
<url-pattern>/reportcriteria</url-pattern>
</servlet-mapping>

</web-app>